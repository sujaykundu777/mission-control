# Hermes Gateway Configuration for Local Development
# This disables API key validation for localhost requests
HERMES_GATEWAY_URL=http://127.0.0.1:7575
HERMES_DEV_MODE=true
HERMES_SKIP_AUTH_LOCALHOST=true

# Or if you want to use API key auth:
# HERMES_API_KEY=sk-your-api-key-here

# Disable any automatic gateway detection that might be happening
NEXT_PUBLIC_USE_LOCAL_MODELS=true
